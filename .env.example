DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=farmconnect
PORT=3000

# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-string

# Free public sample key for data.gov.in (or generate your own personal free key at https://data.gov.in/ -> My Account -> API Keys):
AGMARKNET_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b

# Free Google Gemini API Key for AI Produce Grading (Get your free key in 30 seconds at https://aistudio.google.com/):
GEMINI_API_KEY=

# State filter used by scripts/fetchPrices.js
DEMO_STATE=Maharashtra

# Set to "production" to disable the on-screen dev OTP display in lib/otp.js
NODE_ENV=development
