<%- include('partials/header', { title: 'Market Prices — FarmConnect', active: 'prices' }) %>

  <h1 class="font-display text-3xl font-semibold text-leaf-700"><%= t('prices_title') %></h1>
  <p class="text-soil-500/90 mt-1 mb-2"><%= t('prices_subtitle') %></p>

  <% if (daysStale !== null && daysStale > 2) { %>
    <div class="mb-4 bg-amber-50 border border-amber-200 text-amber-800 text-sm rounded-lg px-4 py-3">
      ⚠️ The newest cached price is <%= daysStale %> days old. This is not live data — run
      <code class="bg-white/60 px-1.5 py-0.5 rounded text-xs">node scripts/fetchPrices.js</code> to refresh it.
    </div>
  <% } %>

  <% if (prices.length === 0) { %>
    <div class="card p-8 text-center text-soil-500">
      No price data yet. Run <code class="bg-soil-50 px-1.5 py-0.5 rounded text-xs">node scripts/fetchPrices.js</code>
      or load <code class="bg-soil-50 px-1.5 py-0.5 rounded text-xs">seed.sql</code> to populate this page.
    </div>
  <% } else { %>
    <div class="card overflow-hidden">
      <table class="ledger w-full text-sm">
        <thead>
          <tr>
            <th class="text-left px-4 py-3 font-semibold">Crop</th>
            <th class="text-left px-4 py-3 font-semibold">Market</th>
            <th class="text-left px-4 py-3 font-semibold">Min ₹</th>
            <th class="text-left px-4 py-3 font-semibold">Max ₹</th>
            <th class="text-left px-4 py-3 font-semibold">Modal ₹</th>
            <th class="text-left px-4 py-3 font-semibold">Date</th>
            <th class="text-left px-4 py-3 font-semibold">Source</th>
            <th class="text-left px-4 py-3 font-semibold">Tip</th>
          </tr>
        </thead>
        <tbody>
          <% prices.forEach(function(p) { %>
            <tr>
              <td class="px-4 py-3 font-medium text-[color:var(--ink)]"><%= p.crop_name %></td>
              <td class="px-4 py-3 text-soil-500/90"><%= p.market %></td>
              <td class="px-4 py-3 text-soil-500/90"><%= p.min_price %></td>
              <td class="px-4 py-3 text-soil-500/90"><%= p.max_price %></td>
              <td class="px-4 py-3 font-bold text-[color:var(--ink)]"><%= p.modal_price %></td>
              <td class="px-4 py-3 text-soil-500/70"><%= new Date(p.price_date).toLocaleDateString('en-IN') %></td>
              <td class="px-4 py-3 text-soil-500/50 text-xs"><%= p.source %></td>
              <td class="px-4 py-3">
                <% if (p.tip.advice === 'sell') { %>
                  <span class="inline-block bg-green-100 text-green-700 text-xs font-semibold px-2.5 py-1 rounded-full"><%= p.tip.label %></span>
                <% } else if (p.tip.advice === 'wait') { %>
                  <span class="inline-block bg-amber-100 text-amber-700 text-xs font-semibold px-2.5 py-1 rounded-full"><%= p.tip.label %></span>
                <% } else { %>
                  <span class="inline-block bg-gray-100 text-gray-600 text-xs font-semibold px-2.5 py-1 rounded-full"><%= p.tip.label %></span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-soil-500/60">
      Tip is a simple rule (today vs. recent cached average), not a forecast — see <code class="bg-soil-50 px-1 rounded">scripts/backtest.js</code> for how it performs against a naive baseline. Prices shown are reference mandi prices, not what a farmer nets after commission and transport.
    </p>
  <% } %>

<%- include('partials/footer') %>
