<%- include('partials/header', { title: 'Instruction Manual — FarmConnect', active: 'manual' }) %>

<div class="max-w-4xl mx-auto space-y-8">
  <!-- Manual Header Banner -->
  <div class="card p-8 bg-gradient-to-r from-leaf-700 via-leaf-600 to-leaf-700 text-white !border-leaf-700 shadow-md">
    <span class="inline-flex items-center gap-1.5 bg-white/20 text-white text-xs font-semibold px-3 py-1 rounded-full mb-3">
      <svg class="w-4 h-4 text-marigold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
      Official User Guide &bull; PS26193
    </span>
    <h1 class="font-display text-3xl sm:text-4xl font-bold">
      FarmConnect Instruction Manual
    </h1>
    <p class="text-leaf-100 text-base mt-2 max-w-2xl leading-relaxed">
      Step-by-step operating guidelines for Farmers, Buyers, and Food Processors to eliminate intermediaries, verify produce quality with AI, and trade at fair APMC mandi benchmarks.
    </p>

    <!-- Quick Navigation Anchor Pills -->
    <div class="mt-6 pt-5 border-t border-white/20 flex items-center gap-2 flex-wrap text-xs font-semibold">
      <span class="text-leaf-200">Jump to:</span>
      <a href="#farmer-guide" class="bg-white/15 hover:bg-white/25 text-white px-3 py-1.5 rounded-lg transition">🌾 Farmer Guide</a>
      <a href="#buyer-guide" class="bg-white/15 hover:bg-white/25 text-white px-3 py-1.5 rounded-lg transition">🛒 Buyer Guide</a>
      <a href="#processor-guide" class="bg-white/15 hover:bg-white/25 text-white px-3 py-1.5 rounded-lg transition">🏭 Processor Guide</a>
      <a href="#ussd-guide" class="bg-white/15 hover:bg-white/25 text-white px-3 py-1.5 rounded-lg transition">📱 USSD Feature Phone</a>
      <a href="#demo-accounts" class="bg-marigold text-field-dark px-3 py-1.5 rounded-lg transition font-bold">🔑 Demo Accounts</a>
    </div>
  </div>

  <!-- SECTION 1: FARMER INSTRUCTION MANUAL -->
  <section id="farmer-guide" class="card p-6 sm:p-8 space-y-6 border-t-4 !border-t-leaf-500">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-leaf-100 text-leaf-700 flex items-center justify-center font-bold text-xl">
        🌾
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold text-leaf-800">1. Farmer's Operating Manual</h2>
        <p class="text-xs text-soil-500">How to list produce, scan quality with AI, check fair prices, and fulfill buyer orders</p>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <!-- Step 1 -->
      <div class="p-4 rounded-xl border border-line bg-paper-50 space-y-2 text-xs">
        <span class="inline-block px-2 py-0.5 rounded bg-leaf-200 text-leaf-900 font-bold text-[10px]">STEP 1</span>
        <h3 class="font-bold text-leaf-800 text-sm">Authentication via Phone &amp; OTP</h3>
        <p class="text-soil-600 leading-relaxed">
          Log in using your 10-digit mobile number and select <strong>Farmer</strong>. For quick demonstration, OTP is displayed on-screen without requiring external telecom gateways.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="p-4 rounded-xl border border-line bg-paper-50 space-y-2 text-xs">
        <span class="inline-block px-2 py-0.5 rounded bg-leaf-200 text-leaf-900 font-bold text-[10px]">STEP 2</span>
        <h3 class="font-bold text-leaf-800 text-sm">AI Produce Quality Inspection</h3>
        <p class="text-soil-600 leading-relaxed">
          On <strong>List a Crop</strong>, click the AI Scanner box to snap or upload a photo of your harvest. The AI inspects skin purity, colour, and blemishes, recommends Grade A/B/C, and estimates remaining shelf life.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="p-4 rounded-xl border border-line bg-paper-50 space-y-2 text-xs">
        <span class="inline-block px-2 py-0.5 rounded bg-leaf-200 text-leaf-900 font-bold text-[10px]">STEP 3</span>
        <h3 class="font-bold text-leaf-800 text-sm">Real-Time Mandi Price Benchmark</h3>
        <p class="text-soil-600 leading-relaxed">
          As you type the crop name and price, FarmConnect compares your quote to today's Agmarknet APMC modal rate (e.g., <em>"Your price is 5% below Pune Mandi reference"</em>) so you never undersell.
        </p>
      </div>

      <!-- Step 4 -->
      <div class="p-4 rounded-xl border border-line bg-paper-50 space-y-2 text-xs">
        <span class="inline-block px-2 py-0.5 rounded bg-leaf-200 text-leaf-900 font-bold text-[10px]">STEP 4</span>
        <h3 class="font-bold text-leaf-800 text-sm">Order Progression &amp; Dispute Resolution</h3>
        <p class="text-soil-600 leading-relaxed">
          Incoming orders move forward strictly: <code class="bg-soil-100 px-1 rounded">Pending &rarr; Confirmed &rarr; Processing &rarr; Delivered</code>. Farmers can also resolve buyer grievance notes directly from the Orders page.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 2: BUYER INSTRUCTION MANUAL -->
  <section id="buyer-guide" class="card p-6 sm:p-8 space-y-6 border-t-4 !border-t-wheat-500">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-wheat-100 text-wheat-700 flex items-center justify-center font-bold text-xl">
        🛒
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold text-leaf-800">2. Buyer's Operating Manual</h2>
        <p class="text-xs text-soil-500">How to discover farm-gate crops, verify grades, place COD orders, and rate farmers</p>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <div class="p-4 rounded-xl border border-line bg-paper-50 space-y-2 text-xs">
        <span class="inline-block px-2 py-0.5 rounded bg-wheat-200 text-wheat-900 font-bold text-[10px]">STEP 1</span>
        <h3 class="font-bold text-leaf-800 text-sm">Browse &amp; Filter by Quality Grade</h3>
        <p class="text-soil-600 leading-relaxed">
          Visit <strong>Browse Crops</strong>. Filter by crop name or quality tier (Grade A export, Grade B retail, Grade C processing). Check the harvest date badge to ensure you buy fresh produce.
        </p>
      </div>

      <div class="p-4 rounded-xl border border-line bg-paper-50 space-y-2 text-xs">
        <span class="inline-block px-2 py-0.5 rounded bg-wheat-200 text-wheat-900 font-bold text-[10px]">STEP 2</span>
        <h3 class="font-bold text-leaf-800 text-sm">Zero-Risk Cash-on-Delivery (COD)</h3>
        <p class="text-soil-600 leading-relaxed">
          Order produce directly from the farmer by specifying the kilogram quantity. No online payment processing is required; payment is settled in cash upon physical produce handover.
        </p>
      </div>

      <div class="p-4 rounded-xl border border-line bg-paper-50 space-y-2 text-xs">
        <span class="inline-block px-2 py-0.5 rounded bg-wheat-200 text-wheat-900 font-bold text-[10px]">STEP 3</span>
        <h3 class="font-bold text-leaf-800 text-sm">Grievance &amp; Issue Raising</h3>
        <p class="text-soil-600 leading-relaxed">
          If delivery is delayed or weights differ, click <strong>+ Raise Grievance</strong> on that order row. Both parties receive the note in real time to reach an amicable solution.
        </p>
      </div>

      <div class="p-4 rounded-xl border border-line bg-paper-50 space-y-2 text-xs">
        <span class="inline-block px-2 py-0.5 rounded bg-wheat-200 text-wheat-900 font-bold text-[10px]">STEP 4</span>
        <h3 class="font-bold text-leaf-800 text-sm">Rating the Farmer (1–5 Stars)</h3>
        <p class="text-soil-600 leading-relaxed">
          Once the farmer marks the order as <code class="bg-green-100 text-green-800 px-1 rounded">Delivered</code>, submit a 1 to 5 star score and comment. This score dynamically builds the farmer's public reputation badge.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 3: PROCESSOR & BULK BUYER MANUAL -->
  <section id="processor-guide" class="card p-6 sm:p-8 space-y-6 border-t-4 !border-t-purple-600">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center font-bold text-xl">
        🏭
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold text-leaf-800">3. Food Processor &amp; Bulk Aggregation Manual</h2>
        <p class="text-xs text-soil-500">How to source commercial quantities from smallholder farmer clusters</p>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <div class="p-4 rounded-xl border border-line bg-paper-50 space-y-2 text-xs">
        <span class="inline-block px-2 py-0.5 rounded bg-purple-200 text-purple-900 font-bold text-[10px]">STEP 1</span>
        <h3 class="font-bold text-leaf-800 text-sm">Group Selling Pools</h3>
        <p class="text-soil-600 leading-relaxed">
          Navigate to <strong>Group Selling</strong>. FarmConnect automatically groups smallholders with the same crop in the same village (e.g. 4 farmers combining 500 kg of Tomatoes in Satara).
        </p>
      </div>

      <div class="p-4 rounded-xl border border-line bg-paper-50 space-y-2 text-xs">
        <span class="inline-block px-2 py-0.5 rounded bg-purple-200 text-purple-900 font-bold text-[10px]">STEP 2</span>
        <h3 class="font-bold text-leaf-800 text-sm">Placing a Bulk Offer</h3>
        <p class="text-soil-600 leading-relaxed">
          Logged-in processors can place a single bulk purchase offer (e.g. ₹18/kg for all 500 kg). FarmConnect automatically partitions and creates individual proportional orders for each contributing farmer.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 4: USSD FEATURE PHONE GUIDE -->
  <section id="ussd-guide" class="card p-6 sm:p-8 space-y-4 border-t-4 !border-t-sky-600">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-sky-100 text-sky-700 flex items-center justify-center font-bold text-xl">
        📱
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold text-leaf-800">4. Basic Phone (USSD) Guidelines</h2>
        <p class="text-xs text-soil-500">Accessible without smartphones or mobile internet</p>
      </div>
    </div>

    <div class="p-4 rounded-xl border border-line bg-paper-50 text-xs text-soil-600 leading-relaxed space-y-2">
      <p>
        Farmers without smartphones dial <strong>*99*1#</strong> on basic GSM phones. The interactive USSD menu provides:
      </p>
      <ul class="list-disc list-inside space-y-1 font-medium text-[color:var(--ink)]">
        <li><strong>Option 1:</strong> Today's Mandi Prices (Tomato, Onion, Wheat)</li>
        <li><strong>Option 2:</strong> Check My Active Orders</li>
        <li><strong>Option 3:</strong> Sell-Now or Wait Advice based on 7-day price corridors</li>
      </ul>
      <p class="text-[11px] text-soil-500 pt-2">
        Test this directly in your browser using the <strong>USSD Simulator</strong> (`/ussd`).
      </p>
    </div>
  </section>

  <!-- SECTION 5: DEMO ACCOUNTS QUICK REFERENCE -->
  <section id="demo-accounts" class="card p-6 sm:p-8 space-y-4 border-2 !border-marigold bg-amber-50/20">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <h2 class="font-display text-xl font-bold text-leaf-800 flex items-center gap-2">
        🔑 Demo Login Accounts Reference
      </h2>
      <span class="text-xs font-bold text-amber-800 bg-amber-100 px-2.5 py-0.5 rounded-full">
        Demo Mode: OTP Shown On-Screen
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-xs border border-line rounded-lg overflow-hidden bg-white">
        <thead class="bg-paper-100 text-soil-700 font-bold border-b border-line">
          <tr>
            <th class="p-2.5 text-left">Role</th>
            <th class="p-2.5 text-left">Demo Phone Number</th>
            <th class="p-2.5 text-left">Account Name</th>
            <th class="p-2.5 text-left">Seeded Role Context</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line text-soil-700">
          <tr>
            <td class="p-2.5 font-bold text-green-700">Farmer</td>
            <td class="p-2.5 font-mono font-bold">9900011111</td>
            <td class="p-2.5">Anil Jadhav</td>
            <td class="p-2.5">Has active Grade A tomatoes (Satara) + delivered orders</td>
          </tr>
          <tr>
            <td class="p-2.5 font-bold text-green-700">Farmer</td>
            <td class="p-2.5 font-mono font-bold">9900022222</td>
            <td class="p-2.5">Balaji More</td>
            <td class="p-2.5">Has active Grade B tomatoes in Satara pool + wheat</td>
          </tr>
          <tr>
            <td class="p-2.5 font-bold text-amber-700">Buyer</td>
            <td class="p-2.5 font-mono font-bold">9900099999</td>
            <td class="p-2.5">Suresh Traders</td>
            <td class="p-2.5">Has delivered order to rate + confirmed order</td>
          </tr>
          <tr>
            <td class="p-2.5 font-bold text-purple-700">Processor</td>
            <td class="p-2.5 font-mono font-bold">9900088888</td>
            <td class="p-2.5">Kisan Food Processors</td>
            <td class="p-2.5">Bulk buyer with placed pool offer on 500 kg tomatoes</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="pt-3 text-center">
      <a href="/login" class="btn btn-primary !py-2 !px-6 text-sm font-bold">
        Login Now &rarr;
      </a>
    </div>
  </section>
</div>

<%- include('partials/footer') %>
