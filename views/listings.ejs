<%- include('partials/header', { title: 'Browse Crops — FarmConnect', active: 'listings' }) %>

  <h1 class="font-display text-3xl font-semibold text-leaf-700"><%= t('listings_title') %></h1>
  <p class="text-soil-500/90 mt-1 mb-6"><%= t('listings_subtitle') %></p>

  <form action="/listings" method="GET" class="flex items-center gap-2 mb-6 flex-wrap">
    <input type="text" name="crop" placeholder="Filter by crop name..." value="<%= filter %>"
      class="border border-line-strong rounded-lg px-3 py-2 w-full max-w-xs bg-paper-50 focus:outline-none focus:ring-2 focus:ring-leaf-500 text-sm">
    <select name="grade" class="border border-line-strong rounded-lg px-3 py-2 bg-paper-50 focus:outline-none focus:ring-2 focus:ring-leaf-500 text-sm">
      <option value=""><%= t('all_grades') %></option>
      <option value="A" <%= gradeFilter === 'A' ? 'selected' : '' %>>Grade A</option>
      <option value="B" <%= gradeFilter === 'B' ? 'selected' : '' %>>Grade B</option>
      <option value="C" <%= gradeFilter === 'C' ? 'selected' : '' %>>Grade C</option>
    </select>
    <button type="submit" class="btn btn-field !py-2">Filter</button>
    <% if (filter || gradeFilter) { %>
      <a href="/listings" class="text-sm text-soil-500 hover:underline">Clear</a>
    <% } %>
  </form>

  <% if (crops.length === 0) { %>
    <div class="card p-8 text-center text-soil-500">
      No crop listings found. Check back soon, or <a href="/add-crop" class="text-leaf-600 font-semibold hover:underline">list your own crop</a>!
    </div>
  <% } else { %>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <% crops.forEach(function(crop) { %>
        <div class="card card-lift p-5 flex flex-col">
          <% if (crop.image_url) { %>
            <div class="mb-3 -mt-1 -mx-1 h-36 rounded-lg overflow-hidden border border-line bg-leaf-50/50 relative">
              <img src="<%= crop.image_url %>" alt="<%= crop.crop_name %>" class="w-full h-full object-cover">
              <span class="absolute top-2 right-2 bg-leaf-700/80 text-white text-[10px] font-bold px-2 py-0.5 rounded-full backdrop-blur-sm">
                AI Inspected
              </span>
            </div>
          <% } %>
          <div class="flex items-start justify-between gap-2 flex-wrap">
            <h3 class="font-display text-lg font-semibold text-leaf-700"><%= crop.crop_name %></h3>
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="whitespace-nowrap text-[11px] font-semibold px-2 py-0.5 rounded-full bg-soil-100 text-soil-700 border border-soil-200">
                Grade <%= crop.grade %>
              </span>
              <% if (crop.comparison) { %>
                <span class="whitespace-nowrap text-[11px] font-semibold px-2 py-0.5 rounded-full <%= crop.comparison.direction === 'above' ? 'bg-amber-100 text-amber-700' : 'bg-green-100 text-green-700' %>">
                  <%= Math.abs(crop.comparison.diffPct) %>% <%= crop.comparison.direction %> mandi
                </span>
              <% } %>
            </div>
          </div>

          <% if (crop.spoilageRisk && crop.spoilageRisk.isAtRisk) { %>
            <div class="mt-2 bg-amber-50 border border-amber-300 text-amber-800 text-xs rounded-lg px-2.5 py-1.5 flex items-center gap-1.5">
              <span>⚠️</span>
              <span><strong><%= t('spoilage_warning') %></strong> (<%= crop.daysSinceHarvest %>d)</span>
            </div>
          <% } %>

          <dl class="mt-2 text-sm text-gray-600 space-y-1 flex-1">
            <div class="flex justify-between"><dt>Quantity</dt><dd class="font-medium text-gray-800"><%= crop.quantity %></dd></div>
            <div class="flex justify-between"><dt>Price</dt><dd class="font-medium text-gray-800">₹<%= crop.price %>/kg</dd></div>
            <% if (crop.comparison) { %>
              <div class="flex justify-between"><dt>Mandi ref (<%= crop.referenceMarket %>)</dt><dd class="text-gray-500">₹<%= crop.comparison.modalPerKg %>/kg</dd></div>
            <% } %>
            <% if (crop.harvest_date) { %>
              <div class="flex justify-between">
                <dt><%= t('label_harvest_date') %></dt>
                <dd class="text-gray-700 font-medium text-xs">
                  <% if (crop.daysSinceHarvest === 0) { %>
                    <%= t('harvested_today') %>
                  <% } else if (crop.daysSinceHarvest === 1) { %>
                    <%= t('harvested_yesterday') %>
                  <% } else { %>
                    <%= t('harvested_days_ago').replace('%d', crop.daysSinceHarvest) %>
                  <% } %>
                </dd>
              </div>
            <% } %>
            <div class="flex justify-between">
              <dt>Farmer</dt>
              <dd class="font-medium text-gray-800 flex items-center gap-1">
                <%= crop.farmer_name %>
                <% if (crop.farmerRating) { %>
                  <span class="inline-flex items-center text-xs font-semibold px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200" title="<%= crop.farmerRating.count %> ratings">
                    ★ <%= crop.farmerRating.avg %>
                  </span>
                <% } %>
              </dd>
            </div>
            <div class="flex justify-between"><dt>Location</dt><dd class="font-medium text-gray-800"><%= crop.location %></dd></div>
          </dl>

          <% if (user) { %>
            <a href="tel:<%= crop.contact %>" class="btn btn-outline mt-4">
              <%= t('contact_farmer') %>: <%= crop.contact %>
            </a>
          <% } else { %>
            <a href="/login?next=/listings"
              class="mt-4 inline-block text-center bg-soil-50/60 text-soil-500 border border-line font-semibold px-4 py-2 rounded-lg hover:bg-soil-50 transition">
              <%= t('login_to_view_contact') %>
            </a>
          <% } %>

          <% if (user && (user.role === 'buyer' || user.role === 'processor')) { %>
            <form action="/listings/<%= crop.id %>/order" method="POST" class="mt-2 flex gap-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="number" step="0.1" name="quantity_kg" placeholder="kg" required
                class="w-20 border border-line-strong rounded-lg px-2 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-wheat-500">
              <button type="submit" class="btn btn-primary flex-1 !py-2 text-sm whitespace-nowrap">
                <%= t('order_cod') %>
              </button>
            </form>
          <% } else if (!user) { %>
            <a href="/login?next=/listings" class="mt-2 block text-center text-xs text-soil-500/70 hover:underline">Login as a buyer to order</a>
          <% } %>
        </div>
      <% }); %>
    </div>
  <% } %>

<%- include('partials/footer') %>
